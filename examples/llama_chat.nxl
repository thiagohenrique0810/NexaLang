# llama_chat.nxl — LLaMA Inference (NexaLang)
#
# Runs any LLaMA-architecture model (TinyLlama, LLaMA 2/3, SmolLM, etc.)
# Architecture: RMSNorm, RoPE, SwiGLU, GQA
# Weight format: artifacts/models/tinyllama.bin (from convert_llama.py)
# Tokenizer: artifacts/models/tinyllama_bpe.bin (SentencePiece → NexaLang BPE)
#
# Compile:
#   python3 bootstrap/main.py examples/llama_chat.nxl --emit ll --opt 3
#   clang artifacts/build/output.ll -o llama_chat -lm -O2 -framework Accelerate

extern "C" {
    fn malloc(size: i32) -> *u8;
    fn free(ptr: *u8);
    fn printf(fmt: *u8, ...) -> i32;
    fn fopen(path: *u8, mode: *u8) -> *u8;
    fn fread(ptr: *u8, size: i64, nmemb: i64, stream: *u8) -> i64;
    fn fclose(stream: *u8) -> i32;
    fn expf(x: f32) -> f32;
    fn sqrtf(x: f32) -> f32;
    fn cosf(x: f32) -> f32;
    fn sinf(x: f32) -> f32;
    fn putchar(c: i32) -> i32;
    fn fflush(stream: *u8) -> i32;
    fn getchar() -> i32;
    fn cblas_sgemm(order: i32, transA: i32, transB: i32, m: i32, n: i32, k: i32,
                   alpha: f32, A: *f32, lda: i32, B: *f32, ldb: i32,
                   beta: f32, C: *f32, ldc: i32);
}

# ═══════════════════════════════════════════════════════════════════════
# Utilities
# ═══════════════════════════════════════════════════════════════════════

fn alloc_raw(n: i32) -> *f32 {
    return cast::<*f32>(malloc(n * 4));
}

fn alloc_f32(n: i32) -> *f32 {
    let buf: *f32 = cast::<*f32>(malloc(n * 4));
    for i in 0..n { buf[i] = 0.0; }
    return buf;
}

fn copy_buf(dst: *f32, src: *f32, n: i32) {
    for i in 0..n { dst[i] = src[i]; }
}

fn ptr_at(base: *f32, offset: i32) -> *f32 {
    return cast::<*f32>(cast::<*u8>(cast::<i64>(base) + cast::<i64>(offset * 4)));
}

fn xorshift32(state: i32) -> i32 {
    let mut s: i32 = state;
    s = s ^ (s << 13);
    s = s ^ (s >> 17);
    s = s ^ (s << 5);
    return s;
}

# ═══════════════════════════════════════════════════════════════════════
# RMSNorm (LLaMA uses RMSNorm, not LayerNorm)
# ═══════════════════════════════════════════════════════════════════════

fn rms_norm_fwd(x: *f32, gamma: *f32, out: *f32, T: i32, D: i32) {
    let eps: f32 = 0.000001;
    for t in 0..T {
        let base: i32 = t * D;
        let mut ss: f32 = 0.0;
        for d in 0..D { ss = ss + x[base + d] * x[base + d]; }
        let rms: f32 = 1.0 / sqrtf(ss / cast::<f32>(D) + eps);
        for d in 0..D {
            out[base + d] = gamma[d] * x[base + d] * rms;
        }
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Softmax
# ═══════════════════════════════════════════════════════════════════════

fn softmax_rows(x: *f32, out: *f32, rows: i32, cols: i32) {
    for r in 0..rows {
        let base: i32 = r * cols;
        let mut mx: f32 = x[base];
        for c in 1..cols {
            if (x[base + c] > mx) { mx = x[base + c]; }
        }
        let mut sum: f32 = 0.0;
        for c in 0..cols {
            out[base + c] = expf(x[base + c] - mx);
            sum = sum + out[base + c];
        }
        let inv: f32 = 1.0 / sum;
        for c in 0..cols { out[base + c] = out[base + c] * inv; }
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Attention (BLAS, per-head)
# ═══════════════════════════════════════════════════════════════════════

fn attention_fwd(Q: *f32, K: *f32, V_in: *f32, out: *f32,
                 attn_scores: *f32, attn_probs: *f32, T: i32, HD: i32) {
    let scale: f32 = 1.0 / sqrtf(cast::<f32>(HD));
    cblas_sgemm(101, 111, 112, T, T, HD, scale, Q, HD, K, HD, 0.0, attn_scores, T);
    for i in 0..T {
        for j in 0..T {
            if (j > i) { attn_scores[i * T + j] = 0.0 - 100000.0; }
        }
    }
    softmax_rows(attn_scores, attn_probs, T, T);
    cblas_sgemm(101, 111, 111, T, HD, T, 1.0, attn_probs, T, V_in, HD, 0.0, out, HD);
}

# ═══════════════════════════════════════════════════════════════════════
# Linear without bias (LLaMA has no bias in linear layers)
# ═══════════════════════════════════════════════════════════════════════

fn linear_nobias(x: *f32, W: *f32, out: *f32, T: i32, in_d: i32, out_d: i32) {
    cblas_sgemm(101, 111, 111, T, out_d, in_d, 1.0, x, in_d, W, out_d, 0.0, out, out_d);
}

# ═══════════════════════════════════════════════════════════════════════
# RoPE (Rotary Position Embeddings)
# ═══════════════════════════════════════════════════════════════════════

fn apply_rope(buf: *f32, T: i32, n_heads: i32, HD: i32) {
    let total_dim: i32 = n_heads * HD;
    let half_hd: i32 = HD / 2;
    let ln_theta: f32 = 9.21034;
    for t in 0..T {
        for h in 0..n_heads {
            let base: i32 = t * total_dim + h * HD;
            for i in 0..half_hd {
                let freq: f32 = expf((0.0 - 2.0) * cast::<f32>(i) * ln_theta / cast::<f32>(HD));
                let angle: f32 = cast::<f32>(t) * freq;
                let cos_v: f32 = cosf(angle);
                let sin_v: f32 = sinf(angle);
                let x0: f32 = buf[base + 2 * i];
                let x1: f32 = buf[base + 2 * i + 1];
                buf[base + 2 * i] = x0 * cos_v - x1 * sin_v;
                buf[base + 2 * i + 1] = x0 * sin_v + x1 * cos_v;
            }
        }
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Sampling
# ═══════════════════════════════════════════════════════════════════════

fn sample_from_probs(probs: *f32, v: i32, seed: i32) -> i32 {
    let state: i32 = xorshift32(seed);
    let r: f32 = cast::<f32>(state & 2147483647) / cast::<f32>(2147483647);
    let mut cumsum: f32 = 0.0;
    for i in 0..v {
        cumsum = cumsum + probs[i];
        if (cumsum >= r) { return i; }
    }
    return v - 1;
}

fn top_k_filter(probs: *f32, V: i32, k: i32) {
    let temp: *f32 = alloc_f32(V);
    copy_buf(temp, probs, V);
    let neg_inf: f32 = 0.0 - 999999.0;
    let mut threshold: f32 = 0.0;
    for pass in 0..k {
        let mut max_val: f32 = neg_inf;
        let mut max_idx: i32 = 0;
        for c in 0..V {
            if (temp[c] > max_val) { max_val = temp[c]; max_idx = c; }
        }
        threshold = max_val;
        temp[max_idx] = neg_inf;
    }
    free(cast::<*u8>(temp));
    let mut rsum: f32 = 0.0;
    for c in 0..V {
        if (probs[c] < threshold) { probs[c] = 0.0; }
        else { rsum = rsum + probs[c]; }
    }
    if (rsum > 0.0) {
        let inv: f32 = 1.0 / rsum;
        for c in 0..V { probs[c] = probs[c] * inv; }
    }
}

# ═══════════════════════════════════════════════════════════════════════
# SentencePiece normalization (prepend ▁, replace spaces with ▁)
# ▁ = U+2581 = UTF-8: 0xE2=226, 0x96=150, 0x81=129
# ═══════════════════════════════════════════════════════════════════════

fn sp_normalize(input: *u8, input_len: i32, output: *u8) -> i32 {
    let mut out_len: i32 = 0;
    output[out_len] = cast::<u8>(226); out_len = out_len + 1;
    output[out_len] = cast::<u8>(150); out_len = out_len + 1;
    output[out_len] = cast::<u8>(129); out_len = out_len + 1;
    for i in 0..input_len {
        if (cast::<i32>(input[i]) == 32) {
            output[out_len] = cast::<u8>(226); out_len = out_len + 1;
            output[out_len] = cast::<u8>(150); out_len = out_len + 1;
            output[out_len] = cast::<u8>(129); out_len = out_len + 1;
        } else {
            output[out_len] = input[i]; out_len = out_len + 1;
        }
    }
    return out_len;
}

# ═══════════════════════════════════════════════════════════════════════
# BPE Encode (SentencePiece-compatible, with byte_start offset)
# ═══════════════════════════════════════════════════════════════════════

fn bpe_encode(input: *u8, input_len: i32, merge_a: *i32, merge_b: *i32,
              num_merges: i32, byte_start: i32, sp_space_id: i32,
              byte_to_piece: *i32, output: *i32) -> i32 {
    # Dummy prefix ▁ (SentencePiece add_dummy_prefix)
    output[0] = sp_space_id;
    let mut len: i32 = 1;
    # Map bytes: space → ▁ piece, else → byte token (byte_start + byte_value)
    for i in 0..input_len {
        if (cast::<i32>(input[i]) == 32) {
            output[len] = sp_space_id;
        } else {
            output[len] = cast::<i32>(input[i]) + byte_start;
        }
        len = len + 1;
    }
    let merge_start: i32 = byte_start + 256;

    for m in 0..num_merges {
        let a: i32 = merge_a[m];
        let b: i32 = merge_b[m];
        let new_tok: i32 = merge_start + m;
        let old_len: i32 = len;
        let mut write: i32 = 0;
        let mut skip: i32 = 0;
        for i in 0..old_len {
            if (skip == 1) { skip = 0; }
            else {
                if (i < old_len - 1) {
                    if (output[i] == a) {
                        if (output[i + 1] == b) {
                            output[write] = new_tok;
                            write = write + 1;
                            skip = 1;
                        } else {
                            output[write] = output[i];
                            write = write + 1;
                        }
                    } else {
                        output[write] = output[i];
                        write = write + 1;
                    }
                } else {
                    output[write] = output[i];
                    write = write + 1;
                }
            }
        }
        len = write;
    }
    # Post-merge remap: replace remaining byte tokens with predefined piece IDs
    for i in 0..len {
        let t: i32 = output[i];
        if (t >= byte_start) {
            if (t < byte_start + 256) {
                output[i] = byte_to_piece[t - byte_start];
            }
        }
    }
    return len;
}

# ═══════════════════════════════════════════════════════════════════════
# LLaMA Forward Pass (RMSNorm + RoPE + SwiGLU + GQA)
# ═══════════════════════════════════════════════════════════════════════

fn llama_forward(ctx: *i32, T: i32, D: i32, H: i32, H_KV: i32, HD: i32, FF: i32, N: i32, V: i32,
    D_KV: i32, tok_emb: *f32,
    all_Wq: *f32, all_Wk: *f32, all_Wv: *f32, all_Wo: *f32, all_ln1: *f32,
    all_gate: *f32, all_up: *f32, all_down: *f32, all_ln2: *f32,
    ln_f: *f32, W_out: *f32,
    residual: *f32, normed: *f32, q_buf: *f32, k_buf: *f32, v_buf: *f32,
    attn_out: *f32, hq: *f32, hk: *f32, hv: *f32, ho: *f32,
    as_buf: *f32, ap_buf: *f32,
    gate_buf: *f32, up_buf: *f32, scratch: *f32, logits: *f32) {

    # Token embedding (no position embedding — RoPE handles positions)
    for t in 0..T {
        let tok: i32 = ctx[t];
        for d in 0..D { residual[t * D + d] = tok_emb[tok * D + d]; }
    }

    let heads_per_kv: i32 = H / H_KV;

    for layer in 0..N {
        let oDD: i32 = layer * D * D;
        let oDK: i32 = layer * D * D_KV;
        let oD: i32 = layer * D;
        let oDF: i32 = layer * D * FF;
        let oFD: i32 = layer * FF * D;

        # 1. RMSNorm before attention
        rms_norm_fwd(residual, ptr_at(all_ln1, oD), normed, T, D);

        # 2. Q/K/V projections (no bias)
        linear_nobias(normed, ptr_at(all_Wq, oDD), q_buf, T, D, D);
        linear_nobias(normed, ptr_at(all_Wk, oDK), k_buf, T, D, D_KV);
        linear_nobias(normed, ptr_at(all_Wv, oDK), v_buf, T, D, D_KV);

        # 3. Apply RoPE to Q and K
        apply_rope(q_buf, T, H, HD);
        apply_rope(k_buf, T, H_KV, HD);

        # 4. Multi-head attention with GQA
        for h in 0..H {
            let kv_h: i32 = h / heads_per_kv;

            # Extract Q head h from q_buf [T, D]
            for t in 0..T { for d in 0..HD {
                hq[t * HD + d] = q_buf[t * D + h * HD + d];
            } }
            # Extract K/V head kv_h from k_buf/v_buf [T, D_KV]
            for t in 0..T { for d in 0..HD {
                hk[t * HD + d] = k_buf[t * D_KV + kv_h * HD + d];
                hv[t * HD + d] = v_buf[t * D_KV + kv_h * HD + d];
            } }

            attention_fwd(hq, hk, hv, ho, as_buf, ap_buf, T, HD);

            # Write back to attn_out [T, D]
            for t in 0..T { for d in 0..HD {
                attn_out[t * D + h * HD + d] = ho[t * HD + d];
            } }
        }

        # 5. Output projection + residual
        linear_nobias(attn_out, ptr_at(all_Wo, oDD), scratch, T, D, D);
        for i in 0..(T * D) { residual[i] = residual[i] + scratch[i]; }

        # 6. RMSNorm before FFN
        rms_norm_fwd(residual, ptr_at(all_ln2, oD), normed, T, D);

        # 7. SwiGLU FFN: silu(gate(x)) * up(x) -> down
        linear_nobias(normed, ptr_at(all_gate, oDF), gate_buf, T, D, FF);
        linear_nobias(normed, ptr_at(all_up, oDF), up_buf, T, D, FF);
        for i in 0..(T * FF) {
            let sig: f32 = 1.0 / (1.0 + expf(0.0 - gate_buf[i]));
            gate_buf[i] = gate_buf[i] * sig * up_buf[i];
        }
        linear_nobias(gate_buf, ptr_at(all_down, oFD), scratch, T, FF, D);
        for i in 0..(T * D) { residual[i] = residual[i] + scratch[i]; }
    }

    # Final RMSNorm + output projection
    rms_norm_fwd(residual, ln_f, normed, T, D);
    linear_nobias(normed, W_out, logits, T, D, V);
}

# ═══════════════════════════════════════════════════════════════════════
# Input helpers
# ═══════════════════════════════════════════════════════════════════════

fn read_line(buf: *u8, max_len: i32) -> i32 {
    let mut len: i32 = 0;
    for i in 0..max_len {
        let c: i32 = getchar();
        if (c == 10) { return len; }
        if (c < 0) {
            if (len == 0) { return 0 - 1; }
            return len;
        }
        buf[len] = cast::<u8>(c);
        len = len + 1;
    }
    return len;
}

fn is_quit(buf: *u8, len: i32) -> i32 {
    if (len == 1) {
        if (cast::<i32>(buf[0]) == 113) { return 1; }
    }
    if (len == 4) {
        if (cast::<i32>(buf[0]) == 113) {
            if (cast::<i32>(buf[1]) == 117) {
                if (cast::<i32>(buf[2]) == 105) {
                    if (cast::<i32>(buf[3]) == 116) { return 1; }
                }
            }
        }
        if (cast::<i32>(buf[0]) == 115) {
            if (cast::<i32>(buf[1]) == 97) {
                if (cast::<i32>(buf[2]) == 105) {
                    if (cast::<i32>(buf[3]) == 114) { return 1; }
                }
            }
        }
    }
    return 0;
}

# ═══════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════

fn main() -> i32 {
    print("╔══════════════════════════════════════════════════════════════╗");
    print("║   NexaLang LLaMA Inference                                ║");
    print("║   Supports TinyLlama, LLaMA 2/3, SmolLM, etc.            ║");
    print("║   Architecture: RMSNorm + RoPE + SwiGLU + GQA            ║");
    print("╚══════════════════════════════════════════════════════════════╝");
    print("");

    # ═══ LOAD WEIGHT FILE HEADER ═══
    print("Carregando modelo...");
    let wf: *u8 = fopen("artifacts/models/tinyllama.bin", "rb");
    if (cast::<i64>(wf) == cast::<i64>(0)) {
        # Backward compatibility with older project layout
        wf = fopen("tinyllama.bin", "rb");
    }
    if (cast::<i64>(wf) == cast::<i64>(0)) {
        print("ERRO: artifacts/models/tinyllama.bin nao encontrado.");
        print("  Execute: python3 tools/convert_llama.py");
        return 1;
    }
    let hdr: *i32 = cast::<*i32>(malloc(28));
    fread(cast::<*u8>(hdr), cast::<i64>(4), cast::<i64>(7), wf);
    let V: i32 = hdr[0];
    let D: i32 = hdr[1];
    let H: i32 = hdr[2];
    let H_KV: i32 = hdr[3];
    let FF: i32 = hdr[4];
    let T: i32 = hdr[5];
    let N: i32 = hdr[6];
    let HD: i32 = D / H;
    let D_KV: i32 = H_KV * HD;
    free(cast::<*u8>(hdr));

    # ═══ LOAD BPE TOKENIZER ═══
    print("Carregando tokenizer...");
    let bpe_f: *u8 = fopen("artifacts/models/tinyllama_bpe.bin", "rb");
    if (cast::<i64>(bpe_f) == cast::<i64>(0)) {
        # Backward compatibility with older project layout
        bpe_f = fopen("tinyllama_bpe.bin", "rb");
    }
    if (cast::<i64>(bpe_f) == cast::<i64>(0)) {
        print("ERRO: artifacts/models/tinyllama_bpe.bin nao encontrado.");
        print("  Execute: python3 tools/convert_llama.py");
        return 1;
    }
    let bpe_hdr: *i32 = cast::<*i32>(malloc(20));
    fread(cast::<*u8>(bpe_hdr), cast::<i64>(4), cast::<i64>(5), bpe_f);
    let num_merges: i32 = bpe_hdr[0];
    let bpe_vocab: i32 = bpe_hdr[1];
    let max_tok_len: i32 = bpe_hdr[2];
    let byte_start: i32 = bpe_hdr[3];
    let sp_space_id: i32 = bpe_hdr[4];
    free(cast::<*u8>(bpe_hdr));

    let bpe_merge_a: *i32 = cast::<*i32>(malloc(num_merges * 4));
    let bpe_merge_b: *i32 = cast::<*i32>(malloc(num_merges * 4));
    fread(cast::<*u8>(bpe_merge_a), cast::<i64>(4), cast::<i64>(num_merges), bpe_f);
    fread(cast::<*u8>(bpe_merge_b), cast::<i64>(4), cast::<i64>(num_merges), bpe_f);
    let byte_to_piece: *i32 = cast::<*i32>(malloc(256 * 4));
    fread(cast::<*u8>(byte_to_piece), cast::<i64>(4), cast::<i64>(256), bpe_f);
    let decode_len: *i32 = cast::<*i32>(malloc(bpe_vocab * 4));
    fread(cast::<*u8>(decode_len), cast::<i64>(4), cast::<i64>(bpe_vocab), bpe_f);
    let decode_data: *u8 = malloc(bpe_vocab * max_tok_len);
    fread(decode_data, cast::<i64>(1), cast::<i64>(bpe_vocab * max_tok_len), bpe_f);
    fclose(bpe_f);
    print("  Tokenizer carregado.");

    # ═══ ALLOCATE AND LOAD WEIGHTS ═══
    print("Carregando pesos (pode demorar)...");
    let tok_emb: *f32 = alloc_raw(V * D);
    let all_Wq: *f32 = alloc_raw(N * D * D);
    let all_Wk: *f32 = alloc_raw(N * D * D_KV);
    let all_Wv: *f32 = alloc_raw(N * D * D_KV);
    let all_Wo: *f32 = alloc_raw(N * D * D);
    let all_ln1: *f32 = alloc_raw(N * D);
    let all_gate: *f32 = alloc_raw(N * D * FF);
    let all_up: *f32 = alloc_raw(N * D * FF);
    let all_down: *f32 = alloc_raw(N * FF * D);
    let all_ln2: *f32 = alloc_raw(N * D);
    let ln_f: *f32 = alloc_raw(D);
    let W_out: *f32 = alloc_raw(D * V);

    fread(cast::<*u8>(tok_emb), cast::<i64>(4), cast::<i64>(V * D), wf);
    fread(cast::<*u8>(all_Wq), cast::<i64>(4), cast::<i64>(N * D * D), wf);
    fread(cast::<*u8>(all_Wk), cast::<i64>(4), cast::<i64>(N * D * D_KV), wf);
    fread(cast::<*u8>(all_Wv), cast::<i64>(4), cast::<i64>(N * D * D_KV), wf);
    fread(cast::<*u8>(all_Wo), cast::<i64>(4), cast::<i64>(N * D * D), wf);
    fread(cast::<*u8>(all_ln1), cast::<i64>(4), cast::<i64>(N * D), wf);
    fread(cast::<*u8>(all_gate), cast::<i64>(4), cast::<i64>(N * D * FF), wf);
    fread(cast::<*u8>(all_up), cast::<i64>(4), cast::<i64>(N * D * FF), wf);
    fread(cast::<*u8>(all_down), cast::<i64>(4), cast::<i64>(N * FF * D), wf);
    fread(cast::<*u8>(all_ln2), cast::<i64>(4), cast::<i64>(N * D), wf);
    fread(cast::<*u8>(ln_f), cast::<i64>(4), cast::<i64>(D), wf);
    fread(cast::<*u8>(W_out), cast::<i64>(4), cast::<i64>(D * V), wf);
    fclose(wf);
    print("  Pesos carregados!");

    # ═══ ACTIVATION BUFFERS ═══
    let residual: *f32 = alloc_raw(T * D);
    let normed: *f32 = alloc_raw(T * D);
    let q_buf: *f32 = alloc_raw(T * D);
    let k_buf: *f32 = alloc_raw(T * D_KV);
    let v_buf: *f32 = alloc_raw(T * D_KV);
    let attn_out: *f32 = alloc_raw(T * D);
    let hq: *f32 = alloc_raw(T * HD);
    let hk: *f32 = alloc_raw(T * HD);
    let hv: *f32 = alloc_raw(T * HD);
    let ho: *f32 = alloc_raw(T * HD);
    let as_buf: *f32 = alloc_raw(T * T);
    let ap_buf: *f32 = alloc_raw(T * T);
    let gate_buf: *f32 = alloc_raw(T * FF);
    let up_buf: *f32 = alloc_raw(T * FF);
    let scratch: *f32 = alloc_raw(T * D);
    let logits: *f32 = alloc_raw(T * V);
    let temp_buf: *f32 = alloc_raw(V);
    let probs: *f32 = alloc_raw(V);

    # ═══ CHAT STATE ═══
    let EOS_ID: i32 = 2;
    let GEN_LEN: i32 = 300;
    let TEMP: f32 = 0.7;
    let TOP_K: i32 = 40;

    let ctx: *i32 = cast::<*i32>(malloc(T * 4));
    for i in 0..T { ctx[i] = 0; }
    let input_buf: *u8 = malloc(2048);
    let prompt_buf: *u8 = malloc(4096);
    let bpe_buf: *i32 = cast::<*i32>(malloc(4096 * 4));
    let mut rng: i32 = 42;

    # ═══ PRIME CONTEXT ═══
    # Push a system/user/assistant example into context
    # "<|system|>\nYou are a helpful assistant.\n<|user|>\nHello!\n<|assistant|>\nHello! How can I help you?\n"
    let prime: *u8 = malloc(512);
    let mut pi: i32 = 0;
    # <|system|>\n
    prime[0] = cast::<u8>(60); prime[1] = cast::<u8>(124); prime[2] = cast::<u8>(115);
    prime[3] = cast::<u8>(121); prime[4] = cast::<u8>(115); prime[5] = cast::<u8>(116);
    prime[6] = cast::<u8>(101); prime[7] = cast::<u8>(109); prime[8] = cast::<u8>(124);
    prime[9] = cast::<u8>(62); prime[10] = cast::<u8>(10);
    pi = 11;
    # You are a helpful assistant.\n
    prime[11] = cast::<u8>(89); prime[12] = cast::<u8>(111); prime[13] = cast::<u8>(117);
    prime[14] = cast::<u8>(32); prime[15] = cast::<u8>(97); prime[16] = cast::<u8>(114);
    prime[17] = cast::<u8>(101); prime[18] = cast::<u8>(32); prime[19] = cast::<u8>(97);
    prime[20] = cast::<u8>(32); prime[21] = cast::<u8>(104); prime[22] = cast::<u8>(101);
    prime[23] = cast::<u8>(108); prime[24] = cast::<u8>(112); prime[25] = cast::<u8>(102);
    prime[26] = cast::<u8>(117); prime[27] = cast::<u8>(108); prime[28] = cast::<u8>(32);
    prime[29] = cast::<u8>(97); prime[30] = cast::<u8>(115); prime[31] = cast::<u8>(115);
    prime[32] = cast::<u8>(105); prime[33] = cast::<u8>(115); prime[34] = cast::<u8>(116);
    prime[35] = cast::<u8>(97); prime[36] = cast::<u8>(110); prime[37] = cast::<u8>(116);
    prime[38] = cast::<u8>(46); prime[39] = cast::<u8>(10);
    pi = 40;
    # <|user|>\nHello!\n
    prime[40] = cast::<u8>(60); prime[41] = cast::<u8>(124); prime[42] = cast::<u8>(117);
    prime[43] = cast::<u8>(115); prime[44] = cast::<u8>(101); prime[45] = cast::<u8>(114);
    prime[46] = cast::<u8>(124); prime[47] = cast::<u8>(62); prime[48] = cast::<u8>(10);
    prime[49] = cast::<u8>(72); prime[50] = cast::<u8>(101); prime[51] = cast::<u8>(108);
    prime[52] = cast::<u8>(108); prime[53] = cast::<u8>(111); prime[54] = cast::<u8>(33);
    prime[55] = cast::<u8>(10);
    pi = 56;
    # <|assistant|>\nHello! How can I help you?\n
    prime[56] = cast::<u8>(60); prime[57] = cast::<u8>(124); prime[58] = cast::<u8>(97);
    prime[59] = cast::<u8>(115); prime[60] = cast::<u8>(115); prime[61] = cast::<u8>(105);
    prime[62] = cast::<u8>(115); prime[63] = cast::<u8>(116); prime[64] = cast::<u8>(97);
    prime[65] = cast::<u8>(110); prime[66] = cast::<u8>(116); prime[67] = cast::<u8>(124);
    prime[68] = cast::<u8>(62); prime[69] = cast::<u8>(10);
    # Hello! How can I help you?\n
    prime[70] = cast::<u8>(72); prime[71] = cast::<u8>(101); prime[72] = cast::<u8>(108);
    prime[73] = cast::<u8>(108); prime[74] = cast::<u8>(111); prime[75] = cast::<u8>(33);
    prime[76] = cast::<u8>(32); prime[77] = cast::<u8>(72); prime[78] = cast::<u8>(111);
    prime[79] = cast::<u8>(119); prime[80] = cast::<u8>(32); prime[81] = cast::<u8>(99);
    prime[82] = cast::<u8>(97); prime[83] = cast::<u8>(110); prime[84] = cast::<u8>(32);
    prime[85] = cast::<u8>(73); prime[86] = cast::<u8>(32); prime[87] = cast::<u8>(104);
    prime[88] = cast::<u8>(101); prime[89] = cast::<u8>(108); prime[90] = cast::<u8>(112);
    prime[91] = cast::<u8>(32); prime[92] = cast::<u8>(121); prime[93] = cast::<u8>(111);
    prime[94] = cast::<u8>(117); prime[95] = cast::<u8>(63); prime[96] = cast::<u8>(10);
    let PRIME_LEN: i32 = 97;

    let prime_bpe: *i32 = cast::<*i32>(malloc(2048 * 4));
    let prime_bpe_len: i32 = bpe_encode(prime, PRIME_LEN, bpe_merge_a, bpe_merge_b,
                                         num_merges, byte_start, sp_space_id,
                                         byte_to_piece, prime_bpe);
    for i in 0..prime_bpe_len {
        for j in 0..(T - 1) { ctx[j] = ctx[j + 1]; }
        ctx[T - 1] = prime_bpe[i];
    }
    free(prime);
    free(cast::<*u8>(prime_bpe));

    print("");
    print("Pronto! LLaMA carregado no NexaLang.");
    print("  Digite sua mensagem e pressione Enter.");
    print("  Digite 'q', 'quit' ou 'sair' para encerrar.");
    print("  (Cada token leva 2-3s em modelos >1B)");
    print("══════════════════════════════════════════════════════════════");

    # ═══ CHAT LOOP ═══
    for turn in 0..10000 {
        print("");
        putchar(62); putchar(32);
        fflush(cast::<*u8>(0));

        let input_len: i32 = read_line(input_buf, 2047);

        if (input_len < 0) {
            print("");
            print("Ate logo!");
            return 0;
        }

        if (is_quit(input_buf, input_len) == 1) {
            print("");
            print("Ate logo!");
            return 0;
        }

        if (input_len > 0) {
            # Build prompt: "<|user|>\n" + input + "\n<|assistant|>\n"
            let mut pb_len: i32 = 0;
            # <|user|>\n
            prompt_buf[0] = cast::<u8>(60); prompt_buf[1] = cast::<u8>(124);
            prompt_buf[2] = cast::<u8>(117); prompt_buf[3] = cast::<u8>(115);
            prompt_buf[4] = cast::<u8>(101); prompt_buf[5] = cast::<u8>(114);
            prompt_buf[6] = cast::<u8>(124); prompt_buf[7] = cast::<u8>(62);
            prompt_buf[8] = cast::<u8>(10);
            pb_len = 9;
            # user input
            for i in 0..input_len {
                prompt_buf[pb_len] = input_buf[i];
                pb_len = pb_len + 1;
            }
            # \n<|assistant|>\n
            prompt_buf[pb_len] = cast::<u8>(10); pb_len = pb_len + 1;
            prompt_buf[pb_len] = cast::<u8>(60); pb_len = pb_len + 1;
            prompt_buf[pb_len] = cast::<u8>(124); pb_len = pb_len + 1;
            prompt_buf[pb_len] = cast::<u8>(97); pb_len = pb_len + 1;
            prompt_buf[pb_len] = cast::<u8>(115); pb_len = pb_len + 1;
            prompt_buf[pb_len] = cast::<u8>(115); pb_len = pb_len + 1;
            prompt_buf[pb_len] = cast::<u8>(105); pb_len = pb_len + 1;
            prompt_buf[pb_len] = cast::<u8>(115); pb_len = pb_len + 1;
            prompt_buf[pb_len] = cast::<u8>(116); pb_len = pb_len + 1;
            prompt_buf[pb_len] = cast::<u8>(97); pb_len = pb_len + 1;
            prompt_buf[pb_len] = cast::<u8>(110); pb_len = pb_len + 1;
            prompt_buf[pb_len] = cast::<u8>(116); pb_len = pb_len + 1;
            prompt_buf[pb_len] = cast::<u8>(124); pb_len = pb_len + 1;
            prompt_buf[pb_len] = cast::<u8>(62); pb_len = pb_len + 1;
            prompt_buf[pb_len] = cast::<u8>(10); pb_len = pb_len + 1;

            let prompt_ntoks: i32 = bpe_encode(prompt_buf, pb_len, bpe_merge_a, bpe_merge_b,
                                                num_merges, byte_start, sp_space_id,
                                                byte_to_piece, bpe_buf);

            for i in 0..prompt_ntoks {
                for j in 0..(T - 1) { ctx[j] = ctx[j + 1]; }
                ctx[T - 1] = bpe_buf[i];
            }

            # ══ GENERATE RESPONSE ══
            let mut done: i32 = 0;

            for g in 0..GEN_LEN {
                if (done == 0) {
                    llama_forward(ctx, T, D, H, H_KV, HD, FF, N, V, D_KV, tok_emb,
                        all_Wq, all_Wk, all_Wv, all_Wo, all_ln1,
                        all_gate, all_up, all_down, all_ln2,
                        ln_f, W_out,
                        residual, normed, q_buf, k_buf, v_buf, attn_out,
                        hq, hk, hv, ho, as_buf, ap_buf,
                        gate_buf, up_buf, scratch, logits);

                    let last_pos: i32 = (T - 1) * V;
                    for c in 0..V { temp_buf[c] = logits[last_pos + c] / TEMP; }
                    softmax_rows(temp_buf, probs, 1, V);
                    top_k_filter(probs, V, TOP_K);

                    rng = xorshift32(rng);
                    let next_tok: i32 = sample_from_probs(probs, V, rng);
                    rng = xorshift32(rng + next_tok);

                    # Stop on EOS token
                    if (next_tok == EOS_ID) { done = 1; }
                    else {
                        # BPE decode: output bytes
                        let tok_base: i32 = next_tok * max_tok_len;
                        let tok_len: i32 = decode_len[next_tok];
                        for b in 0..tok_len {
                            let byte_val: i32 = cast::<i32>(decode_data[tok_base + b]);
                            putchar(byte_val);
                        }
                        fflush(cast::<*u8>(0));

                        # Push token into context
                        for j in 0..(T - 1) { ctx[j] = ctx[j + 1]; }
                        ctx[T - 1] = next_tok;
                    }
                }
            }
            print("");
            print("──────────────────────────────────────────────────────────────");
        }
    }

    return 0;
}
