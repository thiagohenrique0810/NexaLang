# ─────────────────────────────────────────────────────────────────────────────
# std::env — Runtime environment variables and process info
# ─────────────────────────────────────────────────────────────────────────────

extern "C" {
    fn getenv(name: *u8) -> *u8;
    fn setenv(name: *u8, value: *u8, overwrite: i32) -> i32;
    fn unsetenv(name: *u8) -> i32;
    fn getcwd(buf: *u8, size: i32) -> *u8;
    fn getpid() -> i32;
    fn malloc(size: i32) -> *u8;
    fn free(ptr: *u8);
    fn strlen(s: *u8) -> i32;
}

use std::string::String;
use std::option::Option;

# ── Environment Variables ───────────────────────────────────────────────────

pub fn get(name: string) -> Option<String> {
    let result = getenv(cast::<*u8>(name));
    if (cast::<i64>(result) == 0) {
        return Option::<String>::None;
    }
    return Option::<String>::Some(String::from(cast::<string>(result)));
}

pub fn get_or(name: string, default: string) -> String {
    let result = getenv(cast::<*u8>(name));
    if (cast::<i64>(result) == 0) {
        return String::from(default);
    }
    return String::from(cast::<string>(result));
}

pub fn set(name: string, value: string) -> bool {
    return setenv(cast::<*u8>(name), cast::<*u8>(value), 1) == 0;
}

pub fn remove(name: string) -> bool {
    return unsetenv(cast::<*u8>(name)) == 0;
}

pub fn has(name: string) -> bool {
    let result = getenv(cast::<*u8>(name));
    return cast::<i64>(result) != 0;
}

# ── Process Info ────────────────────────────────────────────────────────────

pub fn cwd() -> String {
    let buf = malloc(4096);
    let result = getcwd(buf, 4096);
    if (cast::<i64>(result) == 0) {
        free(buf);
        return String::from(".");
    }
    let s = String::from(cast::<string>(buf));
    free(buf);
    return s;
}

pub fn pid() -> i32 {
    return getpid();
}

# ── Common Shortcuts ────────────────────────────────────────────────────────

pub fn home() -> String {
    return get_or("HOME", "/tmp");
}

pub fn user() -> String {
    return get_or("USER", "unknown");
}

pub fn path() -> String {
    return get_or("PATH", "");
}

pub fn is_production() -> bool {
    let env = get_or("NEXA_ENV", "development");
    # Simple check: starts with 'p'
    let ptr = env.as_ptr();
    let first = cast::<i32>(cast::<*u8>(ptr)[0]);
    return first == 112; # 'p'
}

pub fn port(default: i32) -> i32 {
    let val = getenv(cast::<*u8>("PORT"));
    if (cast::<i64>(val) == 0) {
        return default;
    }
    extern "C" { fn atoi(s: *u8) -> i32; }
    return atoi(val);
}
