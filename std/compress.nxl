# std/compress.nxl — TurboQuant vector compression for NexaLang
#
# Provides near-optimal vector quantization (1–4 bit per coordinate)
# based on TurboQuant (Zandieh et al. 2025, arXiv 2504.19874).
#
# Use cases:
#   - KV-cache compression for transformer inference
#   - Vector database compression for nearest-neighbour search
#   - GPU buffer compaction before dispatch
#   - Network transfer of high-dimensional embeddings
#
# The quantizer is data-oblivious: no calibration data needed.
# Distortion is within factor ≈2.7 of the information-theoretic minimum.

extern "C" {
    fn tq_create(dim: i32, bits: i32, seed: i32) -> *u8;
    fn tq_destroy(ctx: *u8);
    fn tq_quantize_packed(ctx: *u8, input: *f32, output: *u8, n_vectors: i32);
    fn tq_dequantize_packed(ctx: *u8, input: *u8, output: *f32, n_vectors: i32);
    fn tq_mse(ctx: *u8, original: *f32, n_vectors: i32) -> f32;
    fn tq_upper_bound(ctx: *u8) -> f32;
    fn tq_lower_bound(ctx: *u8) -> f32;
    fn tq_quantize_prod(ctx: *u8, input: *f32, out_idx: *u8, out_qjl: *u8, out_gamma: *f32, n_vectors: i32) -> i32;
    fn tq_dequantize_prod(ctx: *u8, in_idx: *u8, in_qjl: *u8, in_gamma: *f32, output: *f32, n_vectors: i32) -> i32;
    fn malloc(size: i32) -> *u8;
    fn free(ptr: *u8);
}

# ── TurboQuantProd payload (MSE base + 1-bit residual sketch) ───────────

pub struct QuantizedProd {
    idx: *u8,
    qjl: *u8,
    gamma: *f32,
    n_vectors: i32,
    dim: i32,
    bits: i32
}

impl QuantizedProd {
    fn drop(self) {
        if (cast::<i64>(self.idx) != 0) {
            free(self.idx);
        }
        if (cast::<i64>(self.qjl) != 0) {
            free(self.qjl);
        }
        if (cast::<i64>(self.gamma) != 0) {
            free(cast::<*u8>(self.gamma));
        }
    }
}

# ── Quantizer ──────────────────────────────────────────────────────────────

pub struct Quantizer {
    handle: *u8,
    dim: i32,
    bits: i32
}

impl Quantizer {
    # Create a new quantizer for vectors of the given dimension and bitwidth.
    # bits: 1..4  (lower = more compression, higher = more accuracy)
    #   1-bit: 32× compression vs f32, MSE ≈ 0.36
    #   2-bit: 16× compression, MSE ≈ 0.117
    #   3-bit: 10.7× compression, MSE ≈ 0.03
    #   4-bit: 8× compression, MSE ≈ 0.009
    fn new(dim: i32, bits: i32) -> Quantizer {
        let h = tq_create(dim, bits, 42);
        return Quantizer(h, dim, bits);
    }

    fn with_seed(dim: i32, bits: i32, seed: i32) -> Quantizer {
        let h = tq_create(dim, bits, seed);
        return Quantizer(h, dim, bits);
    }

    # Quantize n_vectors of f32[dim] into packed bitstream indices.
    # Input buffer:  f32 array of size n_vectors * dim
    # Output buffer: packed bitstream of size compressed_size(n_vectors)
    fn quantize(&self, input: *f32, output: *u8, n_vectors: i32) {
        tq_quantize_packed(self.handle, input, output, n_vectors);
    }

    # Dequantize compressed bitstream back to approximate f32 vectors.
    # Input buffer: packed bitstream of size compressed_size(n_vectors)
    # Output buffer: f32 array of size n_vectors * dim (caller-allocated)
    fn dequantize(&self, input: *u8, output: *f32, n_vectors: i32) {
        tq_dequantize_packed(self.handle, input, output, n_vectors);
    }

    # Compute mean squared error between originals and round-trip reconstruction.
    fn mse(&self, original: *f32, n_vectors: i32) -> f32 {
        return tq_mse(self.handle, original, n_vectors);
    }

    # Theoretical upper bound on MSE: (√(3π)/2) · 4^{-bits}
    fn upper_bound(&self) -> f32 {
        return tq_upper_bound(self.handle);
    }

    # Theoretical lower bound (information-theoretic): 4^{-bits}
    fn lower_bound(&self) -> f32 {
        return tq_lower_bound(self.handle);
    }

    # How many bytes needed for compressed output of n_vectors
    # at 'bits' bits per coordinate.
    fn compressed_size(&self, n_vectors: i32) -> i32 {
        let total_bits = n_vectors * self.dim * self.bits;
        return (total_bits + 7) / 8;
    }

    # Original size in bytes (f32 per coordinate).
    fn original_size(&self, n_vectors: i32) -> i32 {
        return n_vectors * self.dim * 4;
    }

    # Size (bytes) of TurboQuantProd packed base indices at (bits-1) bpc.
    fn prod_idx_size(&self, n_vectors: i32) -> i32 {
        if (self.bits <= 1) {
            return 0;
        }
        let total_bits = n_vectors * self.dim * (self.bits - 1);
        return (total_bits + 7) / 8;
    }

    # Size (bytes) of TurboQuantProd 1-bit QJL payload.
    fn prod_qjl_size(&self, n_vectors: i32) -> i32 {
        let total_bits = n_vectors * self.dim;
        return (total_bits + 7) / 8;
    }

    # Quantize with TurboQuantProd (inner-product oriented).
    # Requires bits >= 2.
    fn quantize_prod(&self, input: *f32, out_idx: *u8, out_qjl: *u8, out_gamma: *f32, n_vectors: i32) {
        let rc = tq_quantize_prod(self.handle, input, out_idx, out_qjl, out_gamma, n_vectors);
        if (rc != 0) {
            return;
        }
    }

    # Dequantize TurboQuantProd payload.
    fn dequantize_prod(&self, in_idx: *u8, in_qjl: *u8, in_gamma: *f32, output: *f32, n_vectors: i32) {
        let rc = tq_dequantize_prod(self.handle, in_idx, in_qjl, in_gamma, output, n_vectors);
        if (rc != 0) {
            return;
        }
    }

    # Allocate payload buffers and quantize using TurboQuantProd.
    fn quantize_prod_alloc(&self, input: *f32, n_vectors: i32) -> QuantizedProd {
        let idx_size = self.prod_idx_size(n_vectors);
        let qjl_size = self.prod_qjl_size(n_vectors);
        let gamma = cast::<*f32>(malloc(n_vectors * 4));
        let idx = malloc(idx_size);
        let qjl = malloc(qjl_size);
        self.quantize_prod(input, idx, qjl, gamma, n_vectors);
        return QuantizedProd(idx, qjl, gamma, n_vectors, self.dim, self.bits);
    }

    fn drop(self) {
        if (cast::<i64>(self.handle) != 0) {
            tq_destroy(self.handle);
        }
    }
}

# ── CompressedBuffer ───────────────────────────────────────────────────────
# A self-contained compressed vector store: quantizer + data.

pub struct CompressedBuffer {
    quant: Quantizer,
    data: *u8,
    n_vectors: i32,
    capacity: i32
}

impl CompressedBuffer {
    # Create a compressed buffer for vectors of given dimension.
    fn new(dim: i32, bits: i32, capacity: i32) -> CompressedBuffer {
        let q = Quantizer::new(dim, bits);
        let total_bits = capacity * dim * bits;
        let buf_size = (total_bits + 7) / 8;
        let buf = malloc(buf_size);
        return CompressedBuffer(q, buf, 0, capacity);
    }

    # Compress and store a single vector.
    fn push(&mut self, vector: *f32) {
        if (self.n_vectors >= self.capacity) {
            return;
        }
        let offset = self.quant.compressed_size(self.n_vectors);
        let dst = cast::<*u8>(cast::<i64>(self.data) + cast::<i64>(offset));
        self.quant.quantize(vector, dst, 1);
        self.n_vectors = self.n_vectors + 1;
    }

    # Decompress a single vector at the given index.
    fn get(&self, index: i32, output: *f32) {
        let offset = self.quant.compressed_size(index);
        let src = cast::<*u8>(cast::<i64>(self.data) + cast::<i64>(offset));
        self.quant.dequantize(src, output, 1);
    }

    fn len(&self) -> i32 {
        return self.n_vectors;
    }

    fn drop(self) {
        if (cast::<i64>(self.data) != 0) {
            free(self.data);
        }
        self.quant.drop();
    }
}

# ── Convenience functions ──────────────────────────────────────────────────

# Quick compress: creates a quantizer, compresses, returns indices buffer.
# Caller must free the returned pointer.
pub fn quick_compress(data: *f32, dim: i32, n_vectors: i32, bits: i32) -> *u8 {
    let q = Quantizer::new(dim, bits);
    let out_size = q.compressed_size(n_vectors);
    let out = malloc(out_size);
    q.quantize(data, out, n_vectors);
    q.drop();
    return out;
}

# Quick decompress: reconstructs f32 vectors from compressed indices.
# Caller must free the returned pointer.
pub fn quick_decompress(indices: *u8, dim: i32, n_vectors: i32, bits: i32) -> *f32 {
    let q = Quantizer::new(dim, bits);
    let out_size = n_vectors * dim * 4;
    let out = cast::<*f32>(malloc(out_size));
    q.dequantize(indices, out, n_vectors);
    q.drop();
    return out;
}

# Quick TurboQuantProd quantize: returns allocated payload.
pub fn quick_quantize_prod(data: *f32, dim: i32, n_vectors: i32, bits: i32) -> QuantizedProd {
    let q = Quantizer::new(dim, bits);
    let payload = q.quantize_prod_alloc(data, n_vectors);
    q.drop();
    return payload;
}

# Quick TurboQuantProd dequantize from payload.
# Caller must free the returned pointer.
pub fn quick_dequantize_prod(payload: QuantizedProd) -> *f32 {
    let q = Quantizer::new(payload.dim, payload.bits);
    let out_size = payload.n_vectors * payload.dim * 4;
    let out = cast::<*f32>(malloc(out_size));
    q.dequantize_prod(payload.idx, payload.qjl, payload.gamma, out, payload.n_vectors);
    q.drop();
    return out;
}
