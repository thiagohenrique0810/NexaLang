{
	"info": {
		"_postman_id": "nexalang-product-api",
		"name": "NexaLang Product API",
		"description": "Collection para testar a API de produtos escrita em NexaLang.\n\nServer: ./dev/artifacts/product_server (porta 8080)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Products",
			"item": [
				{
					"name": "Listar todos os produtos",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/products",
							"host": ["{{base_url}}"],
							"path": ["products"]
						},
						"description": "Retorna um array JSON com todos os produtos cadastrados."
					},
					"response": []
				},
				{
					"name": "Buscar produto por ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/products/1",
							"host": ["{{base_url}}"],
							"path": ["products", "1"]
						},
						"description": "Retorna um produto específico pelo ID."
					},
					"response": []
				},
				{
					"name": "Criar produto",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Widget\",\n    \"price\": 1500,\n    \"stock\": 10\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/products",
							"host": ["{{base_url}}"],
							"path": ["products"]
						},
						"description": "Cria um novo produto. Campos:\n- name (string): nome do produto\n- price (int): preço em centavos\n- stock (int): quantidade em estoque"
					},
					"response": []
				},
				{
					"name": "Criar produto - Gadget",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Gadget Pro\",\n    \"price\": 2999,\n    \"stock\": 25\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/products",
							"host": ["{{base_url}}"],
							"path": ["products"]
						},
						"description": "Cria um segundo produto de exemplo."
					},
					"response": []
				},
				{
					"name": "Criar produto - Sensor",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Sensor IoT\",\n    \"price\": 890,\n    \"stock\": 100\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/products",
							"host": ["{{base_url}}"],
							"path": ["products"]
						},
						"description": "Cria um terceiro produto de exemplo."
					},
					"response": []
				},
				{
					"name": "Atualizar estoque",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"stock\": 50\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/products/1",
							"host": ["{{base_url}}"],
							"path": ["products", "1"]
						},
						"description": "Atualiza o estoque de um produto pelo ID."
					},
					"response": []
				},
				{
					"name": "Deletar produto",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/products/1",
							"host": ["{{base_url}}"],
							"path": ["products", "1"]
						},
						"description": "Remove um produto pelo ID."
					},
					"response": []
				},
				{
					"name": "Produto não encontrado (404)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/products/999",
							"host": ["{{base_url}}"],
							"path": ["products", "999"]
						},
						"description": "Testa o retorno 404 para um ID inexistente."
					},
					"response": []
				},
				{
					"name": "Rota inexistente (404)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/invalid",
							"host": ["{{base_url}}"],
							"path": ["invalid"]
						},
						"description": "Testa o retorno 404 para uma rota não mapeada."
					},
					"response": []
				}
			]
		}
	]
}