{
  "name": "nexalang",
  "displayName": "NexaLang",
  "description": "Syntax highlighting, diagnostics, hover, and completion for NexaLang (.nxl)",
  "version": "0.2.0",
  "publisher": "nexalang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:nexalang"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nexalang",
        "aliases": [
          "NexaLang",
          "nexalang"
        ],
        "extensions": [
          ".nxl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nexalang",
        "scopeName": "source.nexalang",
        "path": "./syntaxes/nexalang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nexalang",
        "path": "./snippets/nexalang.json"
      }
    ],
    "configuration": {
      "title": "NexaLang",
      "properties": {
        "nexalang.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable NexaLang Language Server for diagnostics, hover, and completion"
        },
        "nexalang.lsp.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python interpreter for the LSP server"
        },
        "nexalang.compilerPath": {
          "type": "string",
          "default": "nxc",
          "description": "Path to the NexaLang compiler executable"
        },
        "nexalang.lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a custom lsp_server.py; uses the bundled server by default"
        }
      }
    },
    "commands": [
      {
        "command": "nexalang.build",
        "title": "NexaLang: Build"
      },
      {
        "command": "nexalang.run",
        "title": "NexaLang: Run"
      },
      {
        "command": "nexalang.test",
        "title": "NexaLang: Test"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "scripts": {
    "prepare-server": "node scripts/prepare-server.js",
    "vscode:prepublish": "npm run prepare-server",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  }
}
