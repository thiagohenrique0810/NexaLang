# ─────────────────────────────────────────────────────────────────────────────
# std::crypto — Hashing and basic cryptographic utilities
# ─────────────────────────────────────────────────────────────────────────────
# SHA-256 implemented in pure NexaLang (no external dependency).
# HMAC-SHA256 for signing (JWT, API keys, etc.).
# ─────────────────────────────────────────────────────────────────────────────

extern "C" {
    fn malloc(size: i32) -> *u8;
    fn free(ptr: *u8);
    fn memcpy(dest: *u8, src: *u8, n: i32) -> *u8;
    fn memset(s: *u8, c: i32, n: i32) -> *u8;
    fn strlen(s: *u8) -> i32;
    fn snprintf(buf: *u8, size: i32, fmt: *u8, ...) -> i32;
    fn arc4random_buf(buf: *u8, nbytes: i32);
}

use std::string::String;

# ── SHA-256 Constants ───────────────────────────────────────────────────────

# K constants (first 32 bits of fractional parts of cube roots of first 64 primes)
fn sha256_k(i: i32) -> i32 {
    # Stored as i32, treated as unsigned via bitwise ops
    if (i == 0)  { return 1116352408; }
    if (i == 1)  { return 1899447441; }
    if (i == 2)  { return -1245643825; } # 0x3956C25B
    if (i == 3)  { return -373957723; }  # 0xE9B5DBA5
    if (i == 4)  { return 961987163; }
    if (i == 5)  { return 1508970993; }
    if (i == 6)  { return -1841331548; }
    if (i == 7)  { return -1424204075; }
    if (i == 8)  { return -670586216; }
    if (i == 9)  { return 310598401; }
    if (i == 10) { return 607225278; }
    if (i == 11) { return 1426881987; }
    if (i == 12) { return 1925078388; }
    if (i == 13) { return -2132889090; }
    if (i == 14) { return -1680079193; }
    if (i == 15) { return -1046744716; }
    if (i == 16) { return -459576895; }
    if (i == 17) { return -272742522; }
    if (i == 18) { return 264347078; }
    if (i == 19) { return 604807628; }
    if (i == 20) { return 770255983; }
    if (i == 21) { return 1249150122; }
    if (i == 22) { return 1555081692; }
    if (i == 23) { return 1996064986; }
    if (i == 24) { return -1740746414; }
    if (i == 25) { return -1473132947; }
    if (i == 26) { return -1341970488; }
    if (i == 27) { return -1084653625; }
    if (i == 28) { return -958395405; }
    if (i == 29) { return -710438585; }
    if (i == 30) { return 113926993; }
    if (i == 31) { return 338241895; }
    if (i == 32) { return 666307205; }
    if (i == 33) { return 773529912; }
    if (i == 34) { return 1294757372; }
    if (i == 35) { return 1396182291; }
    if (i == 36) { return 1695183700; }
    if (i == 37) { return 1986661051; }
    if (i == 38) { return -2117940946; }
    if (i == 39) { return -1838011235; }
    if (i == 40) { return -1564481375; }
    if (i == 41) { return -1474664885; }
    if (i == 42) { return -1035236496; }
    if (i == 43) { return -949202525; }
    if (i == 44) { return -778901479; }
    if (i == 45) { return -694614492; }
    if (i == 46) { return -200395387; }
    if (i == 47) { return 275423344; }
    if (i == 48) { return 430227734; }
    if (i == 49) { return 506948616; }
    if (i == 50) { return 659060556; }
    if (i == 51) { return 883997877; }
    if (i == 52) { return 958139571; }
    if (i == 53) { return 1322822218; }
    if (i == 54) { return 1537002063; }
    if (i == 55) { return 1747873779; }
    if (i == 56) { return 1955562222; }
    if (i == 57) { return 2024104815; }
    if (i == 58) { return -2067236844; }
    if (i == 59) { return -1933114872; }
    if (i == 60) { return -1866530822; }
    if (i == 61) { return -1538233109; }
    if (i == 62) { return -1090935817; }
    if (i == 63) { return -965641998; }
    return 0;
}

# ── Bitwise helpers (using i32 as u32) ──────────────────────────────────────

fn rotr(x: i32, n: i32) -> i32 {
    # Logical right shift workaround: (x >>> n) = (x >> n) & mask
    # For unsigned right shift in signed i32
    let left = x << (32 - n);
    # logical right shift
    let right_mask = 2147483647 >> (n - 1); # 0x7FFFFFFF >> (n-1)
    let right = (x >> n) & right_mask;
    return left | right;
}

fn shr(x: i32, n: i32) -> i32 {
    let mask = 2147483647 >> (n - 1);
    return (x >> n) & mask;
}

fn sha256_ch(x: i32, y: i32, z: i32) -> i32 {
    return (x & y) ^ ((~x) & z);
}

fn sha256_maj(x: i32, y: i32, z: i32) -> i32 {
    return (x & y) ^ (x & z) ^ (y & z);
}

fn sha256_sigma0(x: i32) -> i32 {
    return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22);
}

fn sha256_sigma1(x: i32) -> i32 {
    return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25);
}

fn sha256_lsigma0(x: i32) -> i32 {
    return rotr(x, 7) ^ rotr(x, 18) ^ shr(x, 3);
}

fn sha256_lsigma1(x: i32) -> i32 {
    return rotr(x, 17) ^ rotr(x, 19) ^ shr(x, 10);
}

# ── SHA-256 Core ────────────────────────────────────────────────────────────

pub struct Sha256Hash {
    bytes: *u8  # 32 bytes
}

impl Sha256Hash {
    fn to_hex(&self) -> String {
        let buf = malloc(65);
        let hex_chars = "0123456789abcdef";
        let hex_ptr = cast::<*u8>(hex_chars);
        for i in 0..32 {
            let b = cast::<i32>(self.bytes[i]);
            let hi = (b >> 4) & 15;
            let lo = b & 15;
            buf[i * 2] = hex_ptr[hi];
            buf[i * 2 + 1] = hex_ptr[lo];
        }
        buf[64] = cast::<u8>(0);
        let result = String::from(cast::<string>(buf));
        free(buf);
        return result;
    }
}

fn be32_to_bytes(val: i32, out: *u8, off: i32) {
    out[off]     = cast::<u8>((val >> 24) & 255);
    out[off + 1] = cast::<u8>((val >> 16) & 255);
    out[off + 2] = cast::<u8>((val >> 8) & 255);
    out[off + 3] = cast::<u8>(val & 255);
}

fn bytes_to_be32(data: *u8, off: i32) -> i32 {
    let b0 = cast::<i32>(data[off]) << 24;
    let b1 = cast::<i32>(data[off + 1]) << 16;
    let b2 = cast::<i32>(data[off + 2]) << 8;
    let b3 = cast::<i32>(data[off + 3]);
    return b0 | b1 | b2 | b3;
}

pub fn sha256(data: *u8, data_len: i32) -> Sha256Hash {
    # Initial hash values
    let mut h0 = 1779033703;
    let mut h1 = -1150833019;  # 0xBB67AE85
    let mut h2 = 1013904242;
    let mut h3 = -1521486534;  # 0xA54FF53A
    let mut h4 = 1359893119;
    let mut h5 = -1694144372;  # 0x9B05688C
    let mut h6 = 528734635;
    let mut h7 = 1541459225;

    # Pre-processing: pad to 64-byte blocks
    let bit_len = data_len * 8;
    # padded_len = data_len + 1 + pad_zeros + 8, rounded up to 64
    let total = data_len + 9;
    let mut padded_len = 64;
    while (padded_len < total) { padded_len = padded_len + 64; }

    let padded = malloc(padded_len);
    memset(padded, 0, padded_len);
    memcpy(padded, data, data_len);
    padded[data_len] = cast::<u8>(128); # 0x80

    # Append length in bits as big-endian 64-bit at end
    # For simplicity we only handle up to ~256MB (fits in 32 bits of bit length)
    be32_to_bytes(0, padded, padded_len - 8);
    be32_to_bytes(bit_len, padded, padded_len - 4);

    # Process each 64-byte chunk
    let mut chunk_off = 0;
    let w = malloc(256); # 64 * 4 bytes for message schedule
    let w_ptr = cast::<*i32>(w);

    while (chunk_off < padded_len) {
        # Prepare message schedule
        for i in 0..16 {
            w_ptr[i] = bytes_to_be32(padded, chunk_off + i * 4);
        }
        for i in 16..64 {
            w_ptr[i] = sha256_lsigma1(w_ptr[i - 2]) + w_ptr[i - 7] + sha256_lsigma0(w_ptr[i - 15]) + w_ptr[i - 16];
        }

        # Working variables
        let mut a = h0;
        let mut b = h1;
        let mut c = h2;
        let mut d = h3;
        let mut e = h4;
        let mut f = h5;
        let mut g = h6;
        let mut h = h7;

        # 64 rounds
        for i in 0..64 {
            let t1 = h + sha256_sigma1(e) + sha256_ch(e, f, g) + sha256_k(i) + w_ptr[i];
            let t2 = sha256_sigma0(a) + sha256_maj(a, b, c);
            h = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
        }

        h0 = h0 + a;
        h1 = h1 + b;
        h2 = h2 + c;
        h3 = h3 + d;
        h4 = h4 + e;
        h5 = h5 + f;
        h6 = h6 + g;
        h7 = h7 + h;

        chunk_off = chunk_off + 64;
    }

    free(w);
    free(padded);

    # Build result
    let result = malloc(32);
    be32_to_bytes(h0, result, 0);
    be32_to_bytes(h1, result, 4);
    be32_to_bytes(h2, result, 8);
    be32_to_bytes(h3, result, 12);
    be32_to_bytes(h4, result, 16);
    be32_to_bytes(h5, result, 20);
    be32_to_bytes(h6, result, 24);
    be32_to_bytes(h7, result, 28);

    return Sha256Hash(result);
}

pub fn sha256_str(s: string) -> Sha256Hash {
    return sha256(cast::<*u8>(s), strlen(cast::<*u8>(s)));
}

# ── HMAC-SHA256 ─────────────────────────────────────────────────────────────

pub fn hmac_sha256(key: *u8, key_len: i32, msg: *u8, msg_len: i32) -> Sha256Hash {
    let block_size = 64;

    # Prepare key: hash if > 64, pad to 64
    let k_pad = malloc(64);
    memset(k_pad, 0, 64);

    if (key_len > block_size) {
        let hk = sha256(key, key_len);
        memcpy(k_pad, hk.bytes, 32);
    } else {
        memcpy(k_pad, key, key_len);
    }

    # Inner: SHA256((k XOR ipad) || msg)
    let i_key_pad = malloc(64);
    for i in 0..64 {
        i_key_pad[i] = cast::<u8>(cast::<i32>(k_pad[i]) ^ 54); # 0x36
    }
    let inner_data = malloc(64 + msg_len);
    memcpy(inner_data, i_key_pad, 64);
    memcpy(cast::<*u8>(cast::<i64>(inner_data) + 64), msg, msg_len);
    let inner_hash = sha256(inner_data, 64 + msg_len);
    free(i_key_pad);
    free(inner_data);

    # Outer: SHA256((k XOR opad) || inner_hash)
    let o_key_pad = malloc(64);
    for i in 0..64 {
        o_key_pad[i] = cast::<u8>(cast::<i32>(k_pad[i]) ^ 92); # 0x5C
    }
    let outer_data = malloc(64 + 32);
    memcpy(outer_data, o_key_pad, 64);
    memcpy(cast::<*u8>(cast::<i64>(outer_data) + 64), inner_hash.bytes, 32);
    let result = sha256(outer_data, 96);
    free(o_key_pad);
    free(outer_data);
    free(k_pad);

    return result;
}

pub fn hmac_sha256_str(key: string, msg: string) -> Sha256Hash {
    return hmac_sha256(cast::<*u8>(key), strlen(cast::<*u8>(key)),
                       cast::<*u8>(msg), strlen(cast::<*u8>(msg)));
}

# ── Random Bytes ────────────────────────────────────────────────────────────

pub fn random_bytes(n: i32) -> *u8 {
    let buf = malloc(n);
    arc4random_buf(buf, n);
    return buf;
}

pub fn random_hex(n: i32) -> String {
    let bytes = random_bytes(n);
    let hex_chars = "0123456789abcdef";
    let hex_ptr = cast::<*u8>(hex_chars);
    let out = malloc(n * 2 + 1);
    for i in 0..n {
        let b = cast::<i32>(bytes[i]);
        out[i * 2] = hex_ptr[(b >> 4) & 15];
        out[i * 2 + 1] = hex_ptr[b & 15];
    }
    out[n * 2] = cast::<u8>(0);
    free(bytes);
    let result = String::from(cast::<string>(out));
    free(out);
    return result;
}
