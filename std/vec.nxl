use std::option::Option;

pub struct VecIterator<T> {
    ptr: *T,
    len: i32,
    current: i32
}

impl<T> VecIterator<T> {
     fn next(&mut self) -> Option<T> {
         if (self.current < self.len) {
             let val = self.ptr[self.current];
             self.current = self.current + 1;
             return Option::<T>::Some(val);
         }
         return Option::<T>::None;
     }
}

pub struct Vec<T> {
    ptr: *T,
    len: i32,
    cap: i32
}

impl<T> Vec<T> {
    fn new() -> Vec<T> {
        return Vec(cast::<*T>(0), 0, 0);
    }
    
    fn push(&mut self, item: T) {
        if (self.len == self.cap) {
            let mut new_cap: i32 = self.cap * 2;
            if (self.cap == 0) {
                new_cap = 4;
            }
            let item_size: i32 = sizeof::<T>();
            if (item_size < 1) { item_size = 1; }
            if (new_cap <= self.cap or new_cap > 2147483647 / item_size) {
                panic("Vec capacity overflow");
            }
            let new_ptr: *T = cast::<*T>(malloc(new_cap * item_size));
            if (cast::<i64>(new_ptr) == 0) { panic("Vec allocation failed"); }
            if (self.cap > 0) {
                memcpy(new_ptr, self.ptr, self.len * item_size);
                free(self.ptr);
            }
            self.ptr = new_ptr;
            self.cap = new_cap;
        }
        self.ptr[self.len] = item;
        self.len = self.len + 1;
    }
    
    
    # The allocation is owned by Vec; elements removed by pop retain ownership.
    fn drop(self) {
        if (cast::<i64>(self.ptr) != 0) { free(self.ptr); }
    }

    fn iter(&self) -> VecIterator<T> {
        return VecIterator(self.ptr, self.len, 0);
    }

    fn len(&self) -> i32 {
        return self.len;
    }

    fn clear(&mut self) {
        self.len = 0;
    }

    fn get(&self, index: i32) -> Option<T> {
        if (index < 0) { return Option::<T>::None; }
        if (index >= self.len) { return Option::<T>::None; }
        return Option::<T>::Some(self.ptr[index]);
    }

    fn set(&mut self, index: i32, item: T) {
        if (index >= 0) {
            if (index < self.len) {
                self.ptr[index] = item;
            }
        }
    }

    fn pop(&mut self) -> Option<T> {
        if (self.len == 0) { return Option::<T>::None; }
        self.len = self.len - 1;
        return Option::<T>::Some(self.ptr[self.len]);
    }

    fn map<U, F: fn(T) -> U>(&self, f: F) -> Vec<U> {
        let mut result = Vec::<U>::new();
        for i in 0..self.len {
            result.push(f(self.ptr[i]));
        }
        return result;
    }

    fn filter<F: fn(T) -> bool>(&self, f: F) -> Vec<T> {
        let mut result = Vec::<T>::new();
        for i in 0..self.len {
            let item = self.ptr[i];
            if (f(item)) {
                result.push(item);
            }
        }
        return result;
    }

    fn fold<U, F: fn(U, T) -> U>(&self, init: U, f: F) -> U {
        let mut acc = init;
        for i in 0..self.len {
            acc = f(acc, self.ptr[i]);
        }
        return acc;
    }
}
