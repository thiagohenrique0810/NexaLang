{
  "name": "nexalang",
  "displayName": "NexaLang",
  "description": "Syntax highlighting, diagnostics, hover, and completion for NexaLang (.nxl)",
  "version": "0.2.0",
  "publisher": "nexalang",
  "icon": "nexalang-icon.svg",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:nexalang"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nexalang",
        "aliases": ["NexaLang", "nexalang"],
        "extensions": [".nxl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nexalang",
        "scopeName": "source.nexalang",
        "path": "./syntaxes/nexalang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nexalang",
        "path": "./snippets/nexalang.json"
      }
    ],
    "configuration": {
      "title": "NexaLang",
      "properties": {
        "nexalang.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable NexaLang Language Server for diagnostics, hover, and completion"
        },
        "nexalang.lsp.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python interpreter for the LSP server"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}


