use std::vec::Vec;
use std::option::Option;

extern "C" {
    fn sched_yield() -> i32;
}

# Matches the compiler's ABI: { bool done, T result }, including ABI padding.
struct CoroutineState<T> {
    done: bool,
    result: T
}

pub struct Task<T> {
    coro_handle: *u8,
    done: bool
}

impl<T> Task<T> {
    fn is_done(&self) -> bool {
        # The coroutine state struct starts with { i1 done, T result }
        # Read the done flag from the first byte
        let state = cast::<*bool>(self.coro_handle);
        if (cast::<i64>(self.coro_handle) == 0) { return true; }
        return *state;
    }

    fn result(&self) -> T {
        if (cast::<i64>(self.coro_handle) == 0 or !self.is_done()) { panic("Task is not ready"); }
        # The result is stored after the done flag
        let state = cast::<*CoroutineState<T>>(self.coro_handle);
        return (*state).result;
    }
}

pub struct Executor {
    tasks: Vec<*u8>,
    done_count: i32
}

impl Executor {
    fn new() -> Executor {
        return Executor(Vec::<*u8>::new(), 0);
    }

    fn spawn(&mut self, coro: *u8) {
        self.tasks.push(coro);
    }

    fn run(&mut self) {
        let total = self.tasks.len();
        while (self.done_count < total) {
            self.done_count = 0;
            for i in 0..total {
                let handle = self.tasks.get(i).unwrap();
                if (__nexa_is_done(handle)) {
                    self.done_count = self.done_count + 1;
                } else {
                    __nexa_resume(handle);
                }
            }
            if (self.done_count < total) { sched_yield(); }
        }
    }

    fn run_until_complete(&mut self) {
        self.run();
    }
}

# Spawn a single async task and block until it completes
pub fn block_on<T>(coro: *u8) -> T {
    if (cast::<i64>(coro) == 0) { panic("Invalid coroutine handle"); }
    # Poll until done
    let done_ptr = cast::<*bool>(coro);
    while (!*done_ptr) {
        sched_yield();
    }
    let state = cast::<*CoroutineState<T>>(coro);
    return (*state).result;
}

# Built-in compiler hooks for async/await
extern "C" {
    fn __nexa_resume(h: *u8) -> bool;
    fn __nexa_is_done(h: *u8) -> bool;
    fn __nexa_destroy(h: *u8);
}
