# tensor.nxl — Tensor library for NexaLang
#
# Provides f32 tensor operations for ML workloads:
#   - Heap-allocated 2D tensors (matrix / vector)
#   - Element-wise ops (add, sub, mul, scale)
#   - Matrix multiplication via Apple Accelerate BLAS
#   - Reductions (sum, mean)
#   - Random initialization (Xavier)

extern "C" {
    fn malloc(size: i32) -> *u8;
    fn free(ptr: *u8);
    fn cblas_sgemm(order: i32, transA: i32, transB: i32,
                   m: i32, n: i32, k: i32,
                   alpha: f32, A: *f32, lda: i32,
                   B: *f32, ldb: i32,
                   beta: f32, C: *f32, ldc: i32);
}

# ── Tensor struct ──────────────────────────────────────────────────────
# 2D tensor (matrix). Vectors are rows=N, cols=1.
# data and grad are heap-allocated f32 buffers.
struct Tensor {
    data: *f32,
    grad: *f32,
    rows: i32,
    cols: i32,
    size: i32
}

impl Tensor {
    fn new(rows: i32, cols: i32) -> Tensor {
        let size: i32 = rows * cols;
        let data: *f32 = cast::<*f32>(malloc(size * 4));
        let grad: *f32 = cast::<*f32>(malloc(size * 4));
        for i in 0..size {
            data[i] = 0.0;
            grad[i] = 0.0;
        }
        return Tensor(data, grad, rows, cols, size);
    }

    fn drop(&mut self) {
        free(cast::<*u8>(self.data));
        free(cast::<*u8>(self.grad));
    }

    fn get(&self, row: i32, col: i32) -> f32 {
        return self.data[row * self.cols + col];
    }

    fn set(&mut self, row: i32, col: i32, val: f32) {
        self.data[row * self.cols + col] = val;
    }

    fn fill(&mut self, val: f32) {
        for i in 0..self.size {
            self.data[i] = val;
        }
    }

    fn zero_grad(&mut self) {
        for i in 0..self.size {
            self.grad[i] = 0.0;
        }
    }
}

# ── PRNG ───────────────────────────────────────────────────────────────
fn xorshift32(state: i32) -> i32 {
    let mut s: i32 = state;
    s = s ^ (s << 13);
    s = s ^ (s >> 17);
    s = s ^ (s << 5);
    return s;
}

# Xavier-like initialization: U(-scale, scale)
fn tensor_rand_init(data: *f32, n: i32, scale: f32, seed: i32) -> i32 {
    let mut state: i32 = seed;
    for i in 0..n {
        state = xorshift32(state);
        data[i] = (cast::<f32>(state & 2147483647) / cast::<f32>(2147483647) * 2.0 - 1.0) * scale;
    }
    return state;
}

# ── Element-wise operations ────────────────────────────────────────────

# out = a + b  (element-wise, same size)
fn tensor_add(a: *f32, b: *f32, out: *f32, n: i32) {
    for i in 0..n {
        out[i] = a[i] + b[i];
    }
}

# out = a - b
fn tensor_sub(a: *f32, b: *f32, out: *f32, n: i32) {
    for i in 0..n {
        out[i] = a[i] - b[i];
    }
}

# out = a * b  (element-wise / Hadamard)
fn tensor_mul(a: *f32, b: *f32, out: *f32, n: i32) {
    for i in 0..n {
        out[i] = a[i] * b[i];
    }
}

# out = a * scalar
fn tensor_scale(a: *f32, scalar: f32, out: *f32, n: i32) {
    for i in 0..n {
        out[i] = a[i] * scalar;
    }
}

# Add bias: out[s, j] += bias[j]   (out is samples×cols)
fn tensor_add_bias(out: *f32, bias: *f32, samples: i32, cols: i32) {
    for s in 0..samples {
        for j in 0..cols {
            out[s * cols + j] = out[s * cols + j] + bias[j];
        }
    }
}

# ── Matrix Multiplication (BLAS) ──────────────────────────────────────

# C = A @ B      A(m×k), B(k×n), C(m×n)
fn tensor_matmul(A: *f32, B: *f32, C: *f32, m: i32, n: i32, k: i32) {
    cblas_sgemm(101, 111, 111, m, n, k, 1.0, A, k, B, n, 0.0, C, n);
}

# C = A^T @ B    A stored(k×m), op(A)=m×k, B(k×n), C(m×n)
fn tensor_matmul_at(A: *f32, B: *f32, C: *f32, m: i32, n: i32, k: i32) {
    cblas_sgemm(101, 112, 111, m, n, k, 1.0, A, m, B, n, 0.0, C, n);
}

# C = A @ B^T    A(m×k), B stored(n×k), op(B)=k×n, C(m×n)
fn tensor_matmul_bt(A: *f32, B: *f32, C: *f32, m: i32, n: i32, k: i32) {
    cblas_sgemm(101, 111, 112, m, n, k, 1.0, A, k, B, k, 0.0, C, n);
}

# ── Activations ───────────────────────────────────────────────────────

fn tensor_relu(x: *f32, out: *f32, n: i32) {
    for i in 0..n {
        if (x[i] > 0.0) {
            out[i] = x[i];
        } else {
            out[i] = 0.0;
        }
    }
}

fn tensor_relu_backward(x: *f32, d_out: *f32, d_x: *f32, n: i32) {
    for i in 0..n {
        if (x[i] > 0.0) {
            d_x[i] = d_out[i];
        } else {
            d_x[i] = 0.0;
        }
    }
}

fn tensor_sigmoid(x: *f32, out: *f32, n: i32) {
    for i in 0..n {
        if (x[i] > 0.0) {
            let e: f32 = 1.0 / (1.0 + 1.0 / (1.0 + x[i] + x[i] * x[i] * 0.5));
            out[i] = e;
        } else {
            let e: f32 = 1.0 / (1.0 + 1.0 + x[i] * (-1.0) + x[i] * x[i] * 0.5);
            out[i] = e;
        }
    }
}

# ── Loss Functions ────────────────────────────────────────────────────

fn tensor_mse_loss(pred: *f32, target: *f32, n: i32) -> f32 {
    let mut loss: f32 = 0.0;
    for i in 0..n {
        let diff: f32 = pred[i] - target[i];
        loss = loss + diff * diff;
    }
    return loss / cast::<f32>(n);
}

fn tensor_mse_grad(pred: *f32, target: *f32, d_pred: *f32, n: i32) {
    let inv_n: f32 = 2.0 / cast::<f32>(n);
    for i in 0..n {
        d_pred[i] = (pred[i] - target[i]) * inv_n;
    }
}

# ── Reductions ────────────────────────────────────────────────────────

fn tensor_sum(data: *f32, n: i32) -> f32 {
    let mut s: f32 = 0.0;
    for i in 0..n {
        s = s + data[i];
    }
    return s;
}

# Bias gradient: d_bias[j] = sum_s(d_out[s, j])
fn tensor_bias_grad(d_out: *f32, d_bias: *f32, samples: i32, cols: i32) {
    for j in 0..cols {
        d_bias[j] = 0.0;
    }
    for s in 0..samples {
        for j in 0..cols {
            d_bias[j] = d_bias[j] + d_out[s * cols + j];
        }
    }
}

# ── Optimizer ─────────────────────────────────────────────────────────

fn tensor_sgd_update(param: *f32, grad: *f32, n: i32, lr: f32) {
    for i in 0..n {
        param[i] = param[i] - lr * grad[i];
    }
}
