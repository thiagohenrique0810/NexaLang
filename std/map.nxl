use std::vec::Vec;
use std::option::Option;
use std::hash::Hash;

struct Entry<K, V> {
    key: K,
    value: V,
    occupied: bool
}

pub struct HashMap<K, V> {
    entries: Vec<Entry<K, V>>,
    count: i32
}

pub struct HashMapIterator<K, V> {
    map: *HashMap<K, V>,
    index: i32
}

pub struct KeyValuePair<K, V> {
    pub key: K,
    pub value: V
}

impl<K, V> HashMapIterator<K, V> {
    fn next(&mut self) -> Option<KeyValuePair<K, V>> {
        while (self.index < (*self.map).entries.len()) {
            let entry = (*self.map).entries.get(self.index).unwrap();
            self.index = self.index + 1;
            if (entry.occupied) {
                return Option::<KeyValuePair<K, V>>::Some(KeyValuePair::<K, V>(entry.key, entry.value));
            }
        }
        return Option::<KeyValuePair<K, V>>::None;
    }
}

impl<K: Hash, V> HashMap<K, V> {
    fn new() -> HashMap<K, V> {
        let mut entries = Vec::<Entry<K, V>>::new();
        # Pre-allocate 16 slots
        for i in 0..16 {
            entries.push(Entry::<K, V>(cast::<K>(0), cast::<V>(0), false));
        }
        return HashMap(entries, 0);
    }

    fn with_capacity(cap: i32) -> HashMap<K, V> {
        let mut entries = Vec::<Entry<K, V>>::new();
        for i in 0..cap {
            entries.push(Entry::<K, V>(cast::<K>(0), cast::<V>(0), false));
        }
        return HashMap(entries, 0);
    }

    fn _maybe_resize(&mut self) {
        let cap = self.entries.len();
        # Resize at 75% load factor
        if (self.count * 4 < cap * 3) { return; }
        
        let new_cap = cap * 2;
        let mut new_entries = Vec::<Entry<K, V>>::new();
        for i in 0..new_cap {
            new_entries.push(Entry::<K, V>(cast::<K>(0), cast::<V>(0), false));
        }
        
        # Rehash all existing entries
        for i in 0..cap {
            let old = self.entries.get(i).unwrap();
            if (old.occupied) {
                let h = old.key.hash();
                let mut idx = cast::<i32>(h % cast::<u64>(new_cap));
                while (true) {
                    let slot = new_entries.get(idx).unwrap();
                    if (!slot.occupied) {
                        new_entries.set(idx, Entry::<K, V>(old.key, old.value, true));
                        break;
                    }
                    idx = (idx + 1) % new_cap;
                }
            }
        }
        self.entries = new_entries;
    }

    fn insert(&mut self, key: K, value: V) {
        self._maybe_resize();
        let h = key.hash();
        let cap = self.entries.len();
        let mut idx = cast::<i32>(h % cast::<u64>(cap));
        
        while (true) {
            let mut entry = self.entries.get(idx).unwrap();
            if (!entry.occupied) {
                self.entries.set(idx, Entry::<K, V>(key, value, true));
                self.count = self.count + 1;
                return;
            }
            if (entry.key == key) {
                self.entries.set(idx, Entry::<K, V>(key, value, true));
                return;
            }
            idx = (idx + 1) % cap;
        }
    }

    fn get(&self, key: K) -> Option<V> {
        let h = key.hash();
        let cap = self.entries.len();
        let mut idx = cast::<i32>(h % cast::<u64>(cap));
        let start_idx = idx;
        
        while (true) {
            let entry = self.entries.get(idx).unwrap();
            if (!entry.occupied) { return Option::<V>::None; }
            if (entry.key == key) { return Option::<V>::Some(entry.value); }
            
            idx = (idx + 1) % cap;
            if (idx == start_idx) { break; }
        }
        return Option::<V>::None;
    }

    fn contains(&self, key: K) -> bool {
        return self.get(key).is_some();
    }

    fn len(&self) -> i32 {
        return self.count;
    }

    fn is_empty(&self) -> bool {
        return self.count == 0;
    }

    fn remove(&mut self, key: K) -> Option<V> {
        let h = key.hash();
        let cap = self.entries.len();
        let mut idx = cast::<i32>(h % cast::<u64>(cap));
        let start_idx = idx;
        
        while (true) {
            let entry = self.entries.get(idx).unwrap();
            if (!entry.occupied) { return Option::<V>::None; }
            if (entry.key == key) {
                let val = entry.value;
                self.entries.set(idx, Entry::<K, V>(cast::<K>(0), cast::<V>(0), false));
                self.count = self.count - 1;
                return Option::<V>::Some(val);
            }
            idx = (idx + 1) % cap;
            if (idx == start_idx) { break; }
        }
        return Option::<V>::None;
    }

    fn clear(&mut self) {
        let cap = self.entries.len();
        for i in 0..cap {
            self.entries.set(i, Entry::<K, V>(cast::<K>(0), cast::<V>(0), false));
        }
        self.count = 0;
    }

    fn iter(&self) -> HashMapIterator<K, V> {
        return HashMapIterator(self, 0);
    }
}
