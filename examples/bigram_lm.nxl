# bigram_lm.nxl — Character-level Bigram Language Model
#
# Phase 1→3 of Transformer roadmap:
#   - Char tokenizer (65 ASCII chars from Shakespeare)
#   - Token embedding table (65 × 65) = logits directly
#   - Softmax + Cross-entropy loss
#   - SGD training on 1M char corpus
#   - Autoregressive text generation
#
# This is the simplest possible language model:
#   P(next_char | current_char) = softmax(embedding[current_char])
#
# Data format (train.bin): [n_tokens:i32][vocab_size:i32][tokens: n * u8]
#                          followed by [vocab_table: vocab_size * u8]

extern "C" {
    fn malloc(size: i32) -> *u8;
    fn free(ptr: *u8);
    fn printf(fmt: *u8, ...) -> i32;
    fn cblas_sgemm(order: i32, transA: i32, transB: i32,
                   m: i32, n: i32, k: i32,
                   alpha: f32, A: *f32, lda: i32,
                   B: *f32, ldb: i32,
                   beta: f32, C: *f32, ldc: i32);
    fn gettimeofday(tv: *u8, tz: *u8) -> i32;
    fn fopen(path: *u8, mode: *u8) -> *u8;
    fn fread(ptr: *u8, size: i64, nmemb: i64, stream: *u8) -> i64;
    fn fclose(stream: *u8) -> i32;
    fn expf(x: f32) -> f32;
    fn logf(x: f32) -> f32;
    fn putchar(c: i32) -> i32;
    fn fflush(stream: *u8) -> i32;
}

# ═══════════════════════════════════════════════════════════════════════
# Utilities
# ═══════════════════════════════════════════════════════════════════════

fn alloc_f32(n: i32) -> *f32 {
    let buf: *f32 = cast::<*f32>(malloc(n * 4));
    for i in 0..n {
        buf[i] = 0.0;
    }
    return buf;
}

fn alloc_u8(n: i32) -> *u8 {
    return malloc(n);
}

fn xorshift32(state: i32) -> i32 {
    let mut s: i32 = state;
    s = s ^ (s << 13);
    s = s ^ (s >> 17);
    s = s ^ (s << 5);
    return s;
}

struct Timer {
    secs: i64,
    usecs: i32
}

fn timer_now() -> Timer {
    let tv: *u8 = malloc(16);
    gettimeofday(tv, cast::<*u8>(0));
    let secs: i64 = *cast::<*i64>(tv);
    let usecs: i32 = *cast::<*i32>(cast::<*u8>(cast::<i64>(tv) + cast::<i64>(8)));
    free(tv);
    return Timer(secs, usecs);
}

fn elapsed_ms(t1: Timer, t0: Timer) -> i32 {
    let ds: i32 = cast::<i32>(t1.secs - t0.secs);
    let du: i32 = t1.usecs - t0.usecs;
    return ds * 1000 + du / 1000;
}

# ═══════════════════════════════════════════════════════════════════════
# Data loader
# Format: [n_tokens:i32][vocab_size:i32][tokens: n * u8][vocab_table: V * u8]
# ═══════════════════════════════════════════════════════════════════════

fn load_tokens(path: *u8, out_n: *i32, out_vocab: *i32, out_table: *u8) -> *u8 {
    let f: *u8 = fopen(path, "rb");
    if (cast::<i64>(f) == cast::<i64>(0)) {
        print("ERROR: cannot open file");
        return cast::<*u8>(0);
    }

    # Read header
    let hdr: *i32 = cast::<*i32>(malloc(8));
    fread(cast::<*u8>(hdr), cast::<i64>(4), cast::<i64>(2), f);
    let n: i32 = hdr[0];
    let v: i32 = hdr[1];
    *out_n = n;
    *out_vocab = v;
    free(cast::<*u8>(hdr));

    # Read tokens
    let tokens: *u8 = malloc(n);
    fread(tokens, cast::<i64>(1), cast::<i64>(n), f);

    # Read vocab table (tok->char mapping)
    fread(out_table, cast::<i64>(1), cast::<i64>(v), f);

    fclose(f);
    return tokens;
}

# ═══════════════════════════════════════════════════════════════════════
# Softmax + Cross-Entropy (single sample versions for generation)
# ═══════════════════════════════════════════════════════════════════════

# Softmax over a single vector of length V
fn softmax_vec(x: *f32, out: *f32, v: i32) {
    let mut mx: f32 = x[0];
    for i in 1..v {
        if (x[i] > mx) {
            mx = x[i];
        }
    }
    let mut sum: f32 = 0.0;
    for i in 0..v {
        out[i] = expf(x[i] - mx);
        sum = sum + out[i];
    }
    let inv: f32 = 1.0 / sum;
    for i in 0..v {
        out[i] = out[i] * inv;
    }
}

# Cross-entropy loss for a batch of (input_token, target_token) pairs
# Uses embedding table as logits: logits = embedding[input_tok]
fn batch_loss(emb: *f32, tokens: *u8, start: i32, batch_size: i32, v: i32, probs_buf: *f32) -> f32 {
    let mut loss: f32 = 0.0;
    for b in 0..batch_size {
        let input_tok: i32 = cast::<i32>(tokens[start + b]);
        let target_tok: i32 = cast::<i32>(tokens[start + b + 1]);

        # logits = row input_tok of embedding table
        let logit_ptr: *f32 = cast::<*f32>(cast::<*u8>(cast::<i64>(emb) + cast::<i64>(input_tok * v * 4)));
        softmax_vec(logit_ptr, probs_buf, v);

        let mut p: f32 = probs_buf[target_tok];
        if (p < 0.0000001) {
            p = 0.0000001;
        }
        loss = loss - logf(p);
    }
    return loss / cast::<f32>(batch_size);
}

# Backward: d_emb[input_tok, c] += (softmax[c] - one_hot[target, c]) / batch_size
fn batch_backward(emb: *f32, d_emb: *f32, tokens: *u8, start: i32, batch_size: i32, v: i32, probs_buf: *f32) {
    let inv_n: f32 = 1.0 / cast::<f32>(batch_size);
    for b in 0..batch_size {
        let input_tok: i32 = cast::<i32>(tokens[start + b]);
        let target_tok: i32 = cast::<i32>(tokens[start + b + 1]);

        let logit_ptr: *f32 = cast::<*f32>(cast::<*u8>(cast::<i64>(emb) + cast::<i64>(input_tok * v * 4)));
        softmax_vec(logit_ptr, probs_buf, v);

        # Accumulate gradient into d_emb row for input_tok
        let grad_row: *f32 = cast::<*f32>(cast::<*u8>(cast::<i64>(d_emb) + cast::<i64>(input_tok * v * 4)));
        for c in 0..v {
            grad_row[c] = grad_row[c] + probs_buf[c] * inv_n;
        }
        grad_row[target_tok] = grad_row[target_tok] - inv_n;
    }
}

# ═══════════════════════════════════════════════════════════════════════
# SGD
# ═══════════════════════════════════════════════════════════════════════

fn sgd_update(param: *f32, grad: *f32, n: i32, lr: f32) {
    for i in 0..n {
        param[i] = param[i] - lr * grad[i];
        grad[i] = 0.0;
    }
}

# ═══════════════════════════════════════════════════════════════════════
# Text generation — Autoregressive sampling
# ═══════════════════════════════════════════════════════════════════════

# Sample from probability distribution using PRNG
fn sample_from_probs(probs: *f32, v: i32, seed: i32) -> i32 {
    let state: i32 = xorshift32(seed);
    let r: f32 = cast::<f32>(state & 2147483647) / cast::<f32>(2147483647);
    let mut cumsum: f32 = 0.0;
    for i in 0..v {
        cumsum = cumsum + probs[i];
        if (cumsum >= r) {
            return i;
        }
    }
    return v - 1;
}

fn generate_text(emb: *f32, vocab_table: *u8, v: i32, start_tok: i32, n_chars: i32, seed: i32) {
    let probs: *f32 = alloc_f32(v);
    let mut tok: i32 = start_tok;
    let mut rng: i32 = seed;

    for i in 0..n_chars {
        # Print current char
        let ch: i32 = cast::<i32>(vocab_table[tok]);
        putchar(ch);

        # Get logits for this token (= embedding row)
        let logit_ptr: *f32 = cast::<*f32>(cast::<*u8>(cast::<i64>(emb) + cast::<i64>(tok * v * 4)));
        softmax_vec(logit_ptr, probs, v);

        # Sample next token
        rng = xorshift32(rng);
        tok = sample_from_probs(probs, v, rng);
        rng = xorshift32(rng + tok);
    }
    # Flush output
    fflush(cast::<*u8>(0));
    free(cast::<*u8>(probs));
}

# ═══════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════

fn main() -> i32 {
    print("╔══════════════════════════════════════════════════════╗");
    print("║  NexaLang — Bigram Character-Level Language Model   ║");
    print("║  Embedding(65×65) · Softmax+CE · SGD               ║");
    print("║  Corpus: Tiny Shakespeare (1M chars)                ║");
    print("╚══════════════════════════════════════════════════════╝");
    print("");

    # ── Load data ─────────────────────────────────────────────────────
    let p_n: *i32 = cast::<*i32>(malloc(4));
    let p_v: *i32 = cast::<*i32>(malloc(4));
    let vocab_table: *u8 = alloc_u8(256);

    print("Loading training data...");
    let train_tokens: *u8 = load_tokens("data/text/train.bin", p_n, p_v, vocab_table);
    let train_n: i32 = *p_n;
    let V: i32 = *p_v;

    print("Loading validation data...");
    let val_vocab: *u8 = alloc_u8(256);
    let val_tokens: *u8 = load_tokens("data/text/val.bin", p_n, p_v, val_vocab);
    let val_n: i32 = *p_n;

    free(cast::<*u8>(p_n));
    free(cast::<*u8>(p_v));

    print("  Train tokens:");
    print(train_n);
    print("  Val tokens:");
    print(val_n);
    print("  Vocab size:");
    print(V);
    print("");

    # ── Hyperparameters ───────────────────────────────────────────────
    let BATCH: i32 = 64;
    let STEPS: i32 = 10000;
    let lr: f32 = 1.0;
    let EVAL_INTERVAL: i32 = 1000;
    let GEN_LEN: i32 = 300;

    # ── Model: embedding table V×V ────────────────────────────────────
    # For bigram: logits[next] = embedding[current], so shape is V×V
    let emb: *f32 = alloc_f32(V * V);
    let d_emb: *f32 = alloc_f32(V * V);

    # Xavier init
    let mut seed: i32 = 1337;
    let scale: f32 = 0.1;
    for i in 0..(V * V) {
        seed = xorshift32(seed);
        emb[i] = (cast::<f32>(seed & 2147483647) / cast::<f32>(2147483647) * 2.0 - 1.0) * scale;
    }

    let probs_buf: *f32 = alloc_f32(V);

    # ── Training loop ─────────────────────────────────────────────────
    print("Training...");
    let ts0 = timer_now();
    let start_secs: i64 = ts0.secs;
    let start_usecs: i32 = ts0.usecs;
    let mut rng: i32 = 42;

    for step in 0..STEPS {
        # Random batch offset (avoid going past end)
        rng = xorshift32(rng);
        let max_start: i32 = train_n - BATCH - 1;
        let abs_start: i32 = (rng & 2147483647) % max_start;

        # Forward: compute loss
        let loss: f32 = batch_loss(emb, train_tokens, abs_start, BATCH, V, probs_buf);

        # Backward: accumulate gradients
        batch_backward(emb, d_emb, train_tokens, abs_start, BATCH, V, probs_buf);

        # SGD update
        sgd_update(emb, d_emb, V * V, lr);

        # Logging
        if (step % EVAL_INTERVAL == 0) {
            # Compute val loss (on first 1000 tokens)
            let val_loss: f32 = batch_loss(emb, val_tokens, 0, 1000, V, probs_buf);

            let t_now = timer_now();
            let t_ref = Timer(start_secs, start_usecs);
            let ms: i32 = elapsed_ms(t_now, t_ref);

            print("  Step:");
            print(step);
            print("  Train loss:");
            print(loss);
            print("  Val loss:");
            print(val_loss);
            print("  Time (ms):");
            print(ms);
            print("");
        }
    }

    let t_end = timer_now();
    let t_ref2 = Timer(start_secs, start_usecs);
    let total_ms: i32 = elapsed_ms(t_end, t_ref2);

    # ── Final evaluation ──────────────────────────────────────────────
    let final_val_loss: f32 = batch_loss(emb, val_tokens, 0, 2000, V, probs_buf);
    print("══════════════════════════════════════════════════════");
    print("  Training complete");
    print("  Final val loss:");
    print(final_val_loss);
    print("  Total time (ms):");
    print(total_ms);
    print("══════════════════════════════════════════════════════");
    print("");

    # ── Generate text ─────────────────────────────────────────────────
    print("Generated text:");
    print("──────────────────────────────────────────────────────");
    generate_text(emb, vocab_table, V, 0, GEN_LEN, 12345);
    print("");
    print("──────────────────────────────────────────────────────");

    # ── Cleanup ───────────────────────────────────────────────────────
    free(train_tokens);
    free(val_tokens);
    free(cast::<*u8>(emb));
    free(cast::<*u8>(d_emb));
    free(cast::<*u8>(probs_buf));
    free(vocab_table);
    free(val_vocab);

    return 0;
}
